# Supabase — from your project's API settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only (do NOT prefix with NEXT_PUBLIC). Add later if/when needed.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Error monitoring (optional). Paste a Sentry DSN and crashes report
# automatically — no package to install. See docs/MONITORING.md.
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@oyyy.ingest.sentry.io/zzzz
