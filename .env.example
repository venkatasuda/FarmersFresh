# =====================================================================
# Farmers Fresh — environment variables
# Copy to .env.local for local dev (never commit .env.local).
# Values here are PLACEHOLDERS. Each block notes WHERE it must be set in prod.
# A feature stays dark (gracefully) until its keys are present.
# =====================================================================

# ---------------------------------------------------------------------
# CORE — required. Without these the app can't reach the database.
# Set in: Vercel (Project → Settings → Environment Variables) AND GitHub
#         Actions secrets (so CI's build can run).
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (never NEXT_PUBLIC): used by the Razorpay verify routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------
# PAYMENTS — Razorpay. Set in: Vercel.
# Without these, checkout falls back to cash-on-delivery only.
# ---------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxx   # client — shows the online-pay option
RAZORPAY_KEY_ID=rzp_live_xxx               # server
RAZORPAY_KEY_SECRET=your-razorpay-secret   # server
# Webhook secret (Razorpay Dashboard → Settings → Webhooks). Point the webhook
# at /api/razorpay/webhook for the `payment.captured` event.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ---------------------------------------------------------------------
# WEB PUSH (VAPID). The PUBLIC key is set in Vercel; the pair is ALSO set
# as Supabase Edge Function secrets (below) so the worker can send.
# Generate a pair: npx web-push generate-vapid-keys
# ---------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key   # Vercel

# ---------------------------------------------------------------------
# VISUAL SEARCH (camera → product). Set in: Vercel. Optional.
# NEXT_PUBLIC_VISUAL_SEARCH=1 turns the camera button on.
# VISION_PROVIDER: "google" (needs API key) or "custom" (your own model).
# ---------------------------------------------------------------------
NEXT_PUBLIC_VISUAL_SEARCH=          # "1" to enable, blank to hide
VISION_PROVIDER=google             # google | custom
GOOGLE_VISION_API_KEY=
VISION_ENDPOINT_URL=               # for VISION_PROVIDER=custom
VISION_ENDPOINT_TOKEN=             # optional bearer for your endpoint

# ---------------------------------------------------------------------
# DEMAND FORECAST provider. Set in: Vercel. Optional.
# "baseline" (built-in SQL) or "custom" (your own model endpoint).
# ---------------------------------------------------------------------
FORECAST_PROVIDER=baseline         # baseline | custom
FORECAST_ENDPOINT_URL=             # for FORECAST_PROVIDER=custom

# ---------------------------------------------------------------------
# ERROR MONITORING (Sentry). Set in: Vercel. Optional but recommended.
# ---------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# =====================================================================
# SUPABASE EDGE FUNCTION SECRETS  (send-notifications worker)
# These do NOT go in Vercel. Set with:
#   supabase secrets set KEY=value   (or Dashboard → Edge Functions → Secrets)
# SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.
# =====================================================================
# Email (Resend):
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=orders@farmersfresh.store
NOTIFY_SITE_URL=https://farmersfresh.store
# SMS (MSG91):
MSG91_AUTHKEY=
MSG91_SENDER=
# WhatsApp (Cloud API):
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Web push (same pair as above):
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:orders@farmersfresh.store

# =====================================================================
# GITHUB ACTIONS SECRETS  (repo → Settings → Secrets → Actions)
# For CI:  NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY
# For CD:  VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
# =====================================================================

# NOT an env var — do this in the Supabase Dashboard:
#   Auth → URL Configuration → Site URL + Redirect URLs = your production domain
#   (else magic-link / password-reset emails point at localhost).
